# Copy to .env (gitignored) and edit. Real environment variables override this file.
# DEVELOPMENT DEFAULTS: on a server set DEBUG=False and a long random SECRET_KEY (the site refuses to start with DEBUG=False and the key below).
# The key below is for local development only. Make a new one for a server:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-not-a-secret-change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin lives here. It must end with a slash and must not start with one (the site refuses to start otherwise). Use something unguessable in production.
ADMIN_URL=admin/

# Where order proofs (cart and part screenshots) are kept. PRIVATE: outside static and media, never served as a file (the site hands them
# out through a login-checked page). A web server must not expose this folder. Default: private_media/ next to manage.py (gitignored).
# PRIVATE_MEDIA_ROOT=/var/lib/grandma/private_media

# The public address of the site, no trailing slash, no path. Used for links in messages sent outside a page request (the Slack notice) and for the
# redirect addresses of Hack Club and Hackatime. The site refuses to start if it has a path or query, or if DEBUG is False and it does not start with https://.
# SITE_URL=https://grandma.example.com

# The Slack bot's token (xoxb-...), for the direct message sent when a reviewer asks for changes. A secret: only here, never in the admin.
# The Slack app needs the bot scope chat:write. Nothing is sent until SLACK_NOTIFICATIONS is also switched on in the admin (Notifications).
# SLACK_BOT_TOKEN=

# Sign in with Hack Club (Hack Club Auth, accounts/hca.py). Written DISABLED: nothing happens until all three of these are set AND HCA_LOGIN is
# switched on in the admin (Accounts). The client id and secret are SECRETS: only here, NEVER commit them, never put them in the admin.
# Register the app at https://auth.hackclub.com/developer/apps with:
#   redirect URI: <SITE_URL>/login/hackclub/callback/   (exactly, with the trailing slash)
#   scopes:       openid slack_id verification_status    (nothing else: no name, no email, no birthday)
# Staff create participant accounts for Hack Club sign-in with an UNUSABLE password (the admin's "Add user" page: tick "Unusable password"):
# the first sign-in links to an account by its Slack ID, only for an account with no usable password, and never for staff or superusers.
# HCA_CLIENT_ID=
# HCA_CLIENT_SECRET=
# HCA_ISSUER=https://auth.hackclub.com

# Connecting a Hackatime account (accounts/hackatime.py). Written DISABLED: nothing happens until the first two of these are set AND
# HACKATIME_ENABLED is switched on in the admin (Accounts), which also makes the Hackatime step of onboarding real and mandatory. The client id
# and secret are SECRETS: only here, NEVER commit them, never put them in the admin. The token Hackatime hands over is read once and revoked at
# once, never stored. Create the app in Hackatime under "My OAuth Apps" with:
#   redirect URIs (one per line, exactly, with the trailing slash), TWO: <SITE_URL>/connect/hackatime/callback/   (connecting the account)
#                                                                         <SITE_URL>/hackatime/check/callback/   (counting the hours of a project at hand-in)
#   scopes:       profile read                             (profile cannot be left out, and shows more than we keep: we keep only the user id)
#   confidential: yes
# The hours check at hand-in ("Check my hours" on the submit note) uses the same app and credentials; HACKATIME_REQUIRED in the admin makes it a must.
# HACKATIME_CLIENT_ID=
# HACKATIME_CLIENT_SECRET=
# HACKATIME_BASE_URL=https://hackatime.hackclub.com

# Sign-in lockout (django-axes): a username is locked from one address after this many failures, for this many minutes.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=30
# How many reverse proxies stand in front of the site, so the lock counts each person's own address and not the proxy's. 0 (the default) uses
# the connection's address and ignores X-Forwarded-For. Set 1 only when exactly one proxy you run sets or appends X-Forwarded-For itself.
# AXES_PROXY_COUNT=0

# Content Security Policy (Django's own). Enforced by default. Set True to only REPORT violations in the browser console instead of blocking.
# CSP_REPORT_ONLY=False

# Production (DEBUG=False) turns on secure cookies, HTTPS redirect and HSTS by itself. Override only if you must:
# CSRF_TRUSTED_ORIGINS=https://grandma.example.com
# BEHIND_PROXY=True                  # a reverse proxy terminates HTTPS and sends X-Forwarded-Proto
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000       # 0 disables HSTS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
