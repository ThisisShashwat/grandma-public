# Copy to .env (gitignored) and edit. Real environment variables override this file.
# DEVELOPMENT DEFAULTS: on a server set DEBUG=False and a long random SECRET_KEY (the site refuses to start with DEBUG=False and the key below).
# The key below is for local development only. Make a new one for a server:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-not-a-secret-change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin lives here. It must end with a slash and must not start with one (the site refuses to start otherwise).
# In production set a long secret path (for example ADMIN_URL=a-long-secret-word/, trailing slash), staff are handed
# the address by hand; anybody who is not staff is redirected away.
ADMIN_URL=admin/

# The database. Leave unset for the SQLite file (db.sqlite3, development). Production sets the URL the host gives, which needs its driver, for example psycopg, added to requirements then.
# DATABASE_URL=
# LIVE_CACHE_SECONDS=15   # how long the admin settings are kept in memory per process (0 = read the database on every request). A save in the admin clears it at once for that process.
# With a network database each connection is kept for DB_CONN_MAX_AGE seconds (default 60; 0 = a new connection per request, slow over the internet). Ignored for SQLite.
# DB_CONN_MAX_AGE=60

# Where PUBLIC uploads (handed-in screenshots) are kept. On a host: its persistent folder. PRIVATE_MEDIA_ROOT must not be this folder or inside it (the site refuses to start).
# MEDIA_ROOT=/data/media

# Where order proofs (cart and part screenshots) are kept. PRIVATE: outside static and media, never served as a file (the site hands them
# out through a login-checked page). A web server must not expose this folder. Default: private_media/ next to manage.py (gitignored).
# PRIVATE_MEDIA_ROOT=/var/lib/grandma/private_media

# The public address of the site, no trailing slash, no path. Used for links in messages sent outside a page request (the Slack notice) and for the
# redirect addresses of Hack Club and Hackatime. The site refuses to start if it has a path or query, or if DEBUG is False and it does not start with https://.
# SITE_URL=https://grandma.example.com

# The Slack bot's token (xoxb-...), for the direct message sent when a reviewer asks for changes. A secret: only here, never in the admin.
# The Slack app needs the bot scope chat:write. Nothing is sent until SLACK_NOTIFICATIONS is also switched on in the admin (Notifications).
# SLACK_BOT_TOKEN=

# Sign in with Hack Club (Hack Club Auth, accounts/hca.py). Written DISABLED: nothing happens until all three of these are set AND HCA_LOGIN is
# switched on in the admin (Accounts). The client id and secret are SECRETS: only here, NEVER commit them, never put them in the admin.
# Register the app at https://auth.hackclub.com/developer/apps with:
#   redirect URI: <SITE_URL>/login/hackclub/callback/   (exactly, with the trailing slash)
#   scopes:       openid profile slack_id verification_status email    (the `profile` scope gives the first name for the display name, 2026-10-07: only given_name or nickname is read; no birthday; the email is private and kept because Ari, HQ's review tool, requires it on every ship)
# A first sign-in creates the account (gate: Hack Club says ysws_eligible is true, checked at the first sign-in only), a returning
# person is found by the Hack Club id, staff and superusers may sign in this way too (staff sign up like everybody and the owner ticks is_staff by
# hand), and new accounts have no beta access until staff give it.
# HCA_CLIENT_ID=
# HCA_CLIENT_SECRET=
# HCA_ISSUER=https://auth.hackclub.com

# Connecting a Hackatime account (accounts/hackatime.py). Written DISABLED: nothing happens until the first two of these are set AND
# HACKATIME_ENABLED is switched on in the admin (Accounts), which also makes the Hackatime step of onboarding real and mandatory. The client id
# and secret are SECRETS: only here, NEVER commit them, never put them in the admin. The token Hackatime hands over is stored encrypted
# at rest with HACKATIME_TOKEN_KEYS, never logged, never shown, never in the admin. Create the app in Hackatime under "My OAuth Apps" with:
#   redirect URI: <SITE_URL>/connect/hackatime/callback/   (connecting the account, exactly, with the trailing slash)
#   scopes:       profile read                             (profile cannot be left out, and shows more than we keep: we keep only the user id)
#   confidential: yes
# The hours check at hand-in ("Check my hours" on the submit note) uses the stored encrypted token and needs no redirect; HACKATIME_REQUIRED in the admin makes it a must.
# HACKATIME_CLIENT_ID=
# HACKATIME_CLIENT_SECRET=
# HACKATIME_BASE_URL=https://hackatime.hackclub.com
#
# Fernet keys for encrypting stored Hackatime access tokens at rest. Comma separated, newest first.
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by putting a new key in front and keeping the old one until every person has reconnected or the lead runs a re-encrypt.
# Without HACKATIME_TOKEN_KEYS configured, connecting Hackatime is refused.
# HACKATIME_TOKEN_KEYS=

# Ari, HQ's review tool (submissions/ari.py). Environment only, never the admin, never logged. The program id is on the Webhooks docs page of Ari; the two secrets
# (whsec_..., different from each other) are in Ari under Settings, Webhooks. Sending also needs the ARI_ENABLED switch in the admin. Without all three values nothing is sent.
# ARI_PROGRAM_ID=
# ARI_INGEST_SECRET=
# ARI_OUTBOUND_SECRET=

# The public password form on /login/ exists only in development; production has none (the superuser uses the admin's own login page).
# Default follows DEBUG (True in development, False in production).
# PASSWORD_LOGIN=True

# Sign-in lockout (django-axes): a username is locked from one address after this many failures, for this many minutes.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=30
# How many reverse proxies stand in front of the site, so the lock counts each person's own address and not the proxy's. 0 (the default) uses
# the connection's address and ignores X-Forwarded-For. Set 1 only when exactly one proxy you run sets or appends X-Forwarded-For itself.
# AXES_PROXY_COUNT=0

# Content Security Policy (Django's own). Enforced by default. Set True to only REPORT violations in the browser console instead of blocking.
# CSP_REPORT_ONLY=False

# Django serves the public screenshots in media/ itself only when this is on (default follows DEBUG). For a private preview set it True; a real server
# serves media/ from the web server instead. It never serves PRIVATE_MEDIA_ROOT (order proofs).
# SERVE_MEDIA=True

# A PRIVATE PREVIEW: an HTTP Basic password in front of the whole site (static files, media, the admin, the Hack Club callback, everything), and
# X-Robots-Tag noindex on every response. At least 12 characters or the site refuses to start; any user name works. Empty (the default) is off.
# A secret: only here, never committed. Needs HTTPS (a Basic password travels in every request).
# PREVIEW_PASSWORD=

# A server behind a reverse proxy that terminates HTTPS (gunicorn behind nginx or Caddy), the whole environment:
#   DEBUG=False
#   SECRET_KEY=<a long random key, the command is at the top>
#   ALLOWED_HOSTS=grandma.example.com
#   CSRF_TRUSTED_ORIGINS=https://grandma.example.com
#   SITE_URL=https://grandma.example.com
#   ADMIN_URL=a-long-secret-word/
#   BEHIND_PROXY=True                  # the proxy must set X-Forwarded-Proto and must overwrite, never pass on, the one a visitor sends
#   SERVE_MEDIA=True                   # only while Django serves media/ itself (a preview)
# and run: python manage.py collectstatic --noinput (WhiteNoise then serves static/), gunicorn grandma.wsgi.

# Production (DEBUG=False) turns on secure cookies, HTTPS redirect and HSTS by itself. Override only if you must:
# CSRF_TRUSTED_ORIGINS=https://grandma.example.com
# BEHIND_PROXY=True                  # a reverse proxy terminates HTTPS and sends X-Forwarded-Proto
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000       # 0 disables HSTS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# The time zone the ADMIN shows times in (default Asia/Kolkata). Stored times are always UTC; the dashboard shows each person's own zone.
# TIME_ZONE=Asia/Kolkata

# IDENTITY FOR HQ'S UNIFIED RECORD (todo item 2). OFF unless BOTH are set. Birthdate and address are scopes Hack Club only grants to apps it marked official
# (ours is, per the owner); if a sign-in is refused with an invalid scope, unset HCA_IDENTITY. PII_KEYS are Fernet keys, newest first, environment only, never committed.
# HCA_IDENTITY=true
# PII_KEYS=

# How long browsers and shared caches may keep the home page and the guides without asking us (Cache-Control max-age, pages/public_cache.py). 60 default, 0 = off.
# PUBLIC_PAGE_CACHE_SECONDS=60
# PII_KEYS ALONE keeps the name Hack Club gives (encrypted): a display name typed in onboarding that matches it skips the rude word check. HCA_IDENTITY on top also asks for birthdate and address.

# THE ONLY WAY AN ADMIN IS MADE (accounts/hca.py grant_staff, 2026-10-09). Comma separated Slack member IDs. A Hack Club sign-in whose verified Slack ID is listed becomes
# staff, superuser and a beta member, at the first sign-in and at every later one. Nothing else makes an admin: do not run createsuperuser on a server (an account Hack Club
# made has no usable password, so the admin's own password form lets nobody in). Empty promotes nobody. Removing an ID does not demote: untick by hand in the admin.
# STAFF_SLACK_IDS=U01ABC23DEF,U01XYZ98GHI

# PUBLIC screenshots on Cloudflare R2 (S3 compatible). All five or none (none keeps MEDIA_ROOT). The access key and secret are SECRETS: only here or in the host's secret
# variables, never committed, never in chat. R2_PUBLIC_URL is where the bucket is readable by anybody (https, no path). Order proofs NEVER go there.
# R2_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://...

# REQUEST LIMITS (pages/body_cap.py, pages/rate_limit.py; docs/security.md "Request limits"). These are the defaults. Set AXES_PROXY_COUNT (above) when a proxy stands in front.
# FORM_BODY_MAX_KB=128
# UPLOAD_BODY_MAX_MB=22
# RATE_LIMITS_ENABLED=True
# RATE_LIMIT_GET=1200
# RATE_LIMIT_POST_IP=600
# RATE_LIMIT_POST_SESSION=60
# RATE_LIMIT_SIGN_IN=300

# PER ENVIRONMENT DEFAULTS for the admin settings (grandma/settings.py). Comma separated KEY=value; a value saved in the admin always wins. A new server needs
# HCA_LOGIN on before anybody can reach its admin: SETTING_DEFAULTS=HCA_LOGIN=true,HACKATIME_ENABLED=true,HACKATIME_REQUIRED=true,ORDER_CART_SCREENSHOT=false
# SETTING_DEFAULTS=
