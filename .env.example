# Copy to .env (gitignored) and edit. Real environment variables override this file.
# The key below is for local development only. Make a new one for a server:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-not-a-secret-change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin lives here. Keep the trailing slash. Use something unguessable in production.
ADMIN_URL=admin/

# Where order proofs (cart and part screenshots) are kept. PRIVATE: outside static and media, never served as a file (the site hands them
# out through a login-checked page). A web server must not expose this folder. Default: private_media/ next to manage.py (gitignored).
# PRIVATE_MEDIA_ROOT=/var/lib/grandma/private_media

# The public address of the site, no trailing slash. Used for links in messages sent outside a page request (the Slack notice).
# SITE_URL=https://grandma.example.com

# The Slack bot's token (xoxb-...), for the direct message sent when a reviewer asks for changes. A secret: only here, never in the admin.
# The Slack app needs the bot scope chat:write. Nothing is sent until SLACK_NOTIFICATIONS is also switched on in the admin (Notifications).
# SLACK_BOT_TOKEN=

# Sign-in lockout (django-axes): a username is locked from one address after this many failures, for this many minutes.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=30

# Production (DEBUG=False) turns on secure cookies, HTTPS redirect and HSTS by itself. Override only if you must:
# CSRF_TRUSTED_ORIGINS=https://grandma.example.com
# BEHIND_PROXY=True                  # a reverse proxy terminates HTTPS and sends X-Forwarded-Proto
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000       # 0 disables HSTS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
